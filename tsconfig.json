{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler", "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "strict": true, "noUncheckedIndexedAccess": true, "exactOptionalPropertyTypes": true, "noImplicitOverride": true,
    "skipLibCheck": true, "jsx": "preserve", "jsxImportSource": "solid-js", "types": ["bun"],
    "baseUrl": ".", "paths": { "@bunker/core": ["packages/core/src/index.ts"], "@bunker/vault": ["packages/vault/src/index.ts"], "@bunker/offline": ["packages/offline/src/index.ts"] }
  },
  "include": ["apps/**/*.ts", "apps/**/*.tsx", "packages/**/*.ts", "tests/**/*.ts", "scripts/**/*.ts"]
}
